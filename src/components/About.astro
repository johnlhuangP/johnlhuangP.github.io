---
import { site } from '../data/site';
---

<section id="about">
  <div class="eyebrow">About</div>
  <div class="about-copy">
    <h2>{site.about.heading}</h2>
    {site.about.paragraphs.map((paragraph) => (
      <p class:list={{ placeholder: paragraph.placeholder }}>{paragraph.text}</p>
    ))}
  </div>
</section>
