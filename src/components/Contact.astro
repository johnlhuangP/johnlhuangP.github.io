---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="contact">
  <div class="page">
    <div class="eyebrow">Contact</div>
    <h2>{site.contact.heading}</h2>
    <p>{site.contact.blurb}</p>
    <div class="contact-line">
      <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="contact-icons">
        <a href={site.github} aria-label="GitHub" title="GitHub" target="_blank" rel="noreferrer"><Icon name="github" /></a>
        <a href={site.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noreferrer"><Icon name="linkedin" /></a>
      </div>
    </div>
  </div>
</section>
